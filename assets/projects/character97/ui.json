ored. The scalloped strip behind the lowered hand bends with the garment because it is an attached part of the clothing. The sword and gripping hand together make only a barely perceptible vertical drift, keeping the original grip and blade shape.\n\nEnd on <Picture 2>, smoothly completing the same cloth movement and returning to the opening composition. The red field stays flat and unchanged, and the small fixed floral jewelry retains the same dimensions from beginning to end.\n\noverall_soundscape: N/A\n\nnon_diegetic_music: N/A\n"}, "color": "#23352b", "bgcolor": "#35503f"}, {"id": 307, "type": "RandomNoise", "pos": [660, 265], "size": [346.12265625, 115], "flags": {}, "order": 10, "mode": 0, "inputs": [], "outputs": [{"name": "NOISE", "type": "NOISE", "links": [445, 477]}], "title": "本轮固定 seed｜记录对照", "properties": {"Node name for S&R": "RandomNoise", "cnr_id": "comfy-core", "ver": "0.30.0", "ue_properties": {"widget_ue_connectable": {}, "version": "7.5.2", "input_ue_unconnectable": {}}}, "widgets_values": [322853979834763, "randomize"], "widgets_values_named": {"noise_seed": 322853979834763, "control_after_generate": "randomize"}}, {"id": 403, "type": "VHS_VideoCombine", "pos": [2385, 970], "size": [650, 978], "flags": {}, "order": 48, "mode": 0, "inputs": [{"name": "images", "type": "IMAGE", "link": 623}, {"name": "audio", "shape": 7, "type": "AUDIO", "link": null}, {"name": "meta_batch", "shape": 7, "type": "VHS_BatchManager", "link": null}, {"name": "vae", "shape": 7, "type": "VAE", "link": null}], "outputs": [{"name": "Filenames", "type": "VHS_FILENAMES", "slot_index": 0, "links": []}], "title": "Raw VAE output video | no correction or composition", "properties": {"Node name for S&R": "VHS_VideoCombine"}, "widgets_values": {"frame_rate": 24, "loop_count": 0, "filename_prefix": "H3_05_Red_97_RawCloth_20260912/v14_HQ_0p6_32_1p6x_20p6_raw_seed_308848260085483/raw/97_v14_HQ_0p6_32_1p6x_20p6_raw_308848260085483_raw", "format": "video/h264-mp4", "pix_fmt": "yuv420